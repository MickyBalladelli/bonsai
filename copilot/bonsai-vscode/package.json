{
  "name": "bonsai-vscode",
  "displayName": "Bonsai",
  "description": "Bonsai context for GitHub Copilot Chat and Codex.",
  "version": "0.5.3",
  "publisher": "MickyBalladelli",
  "author": {
    "name": "Micky Balladelli"
  },
  "private": true,
  "icon": "images/bonsai.png",
  "repository": {
    "type": "git",
    "url": "file:../.."
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:bonsai.generateContext",
    "onCommand:bonsai.generateAndAsk",
    "onCommand:bonsai.copyContext",
    "onCommand:bonsai.copyChangedContext",
    "onCommand:bonsai.copyProjectMap",
    "onCommand:bonsai.previewProjectMap",
    "onCommand:bonsai.openContext",
    "onCommand:bonsai.moreActions",
    "onCommand:bonsai.setup"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bonsai.generateContext",
        "title": "Bonsai: Generate"
      },
      {
        "command": "bonsai.generateAndAsk",
        "title": "Bonsai: Generate and Ask"
      },
      {
        "command": "bonsai.copyContext",
        "title": "Bonsai: Copy Context Prompt"
      },
      {
        "command": "bonsai.copyChangedContext",
        "title": "Bonsai: Generate Changed"
      },
      {
        "command": "bonsai.copyProjectMap",
        "title": "Bonsai: Copy Project Map"
      },
      {
        "command": "bonsai.previewProjectMap",
        "title": "Bonsai: Preview Project Map"
      },
      {
        "command": "bonsai.openContext",
        "title": "Bonsai: Open Last Context"
      },
      {
        "command": "bonsai.moreActions",
        "title": "Bonsai: More Actions"
      },
      {
        "command": "bonsai.setup",
        "title": "Bonsai: Run Setup"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bonsai.generateContext",
          "when": "true"
        },
        {
          "command": "bonsai.copyChangedContext",
          "when": "true"
        },
        {
          "command": "bonsai.generateAndAsk",
          "when": "true"
        },
        {
          "command": "bonsai.moreActions",
          "when": "true"
        },
        {
          "command": "bonsai.copyContext",
          "when": "false"
        },
        {
          "command": "bonsai.copyProjectMap",
          "when": "false"
        },
        {
          "command": "bonsai.previewProjectMap",
          "when": "false"
        },
        {
          "command": "bonsai.openContext",
          "when": "false"
        },
        {
          "command": "bonsai.setup",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Bonsai",
        "properties": {
        "bonsai.maxTokens": {
          "type": "number",
          "default": 4000,
          "minimum": 1000,
          "order": 1,
          "description": "Token budget for generated Copilot context."
        },
        "bonsai.level": {
          "type": "number",
          "default": 2,
          "enum": [
            1,
            2,
            3
          ],
          "order": 2,
          "description": "Compression: 1 full source first, 2 signatures and shapes, 3 names and tree map. Start with 2."
        },
        "bonsai.outputFile": {
          "type": "string",
          "default": "bonsai.xml",
          "order": 3,
          "description": "File path where generated context is written."
        },
        "bonsai.outputFormat": {
          "type": "string",
          "default": "xml",
          "enum": [
            "xml",
            "json"
          ],
          "order": 4,
          "description": "Generated context format. The extension supports XML and JSON. Use the CLI for text output."
        }
      }
      },
      {
        "title": "Bonsai: Advanced",
        "properties": {
          "bonsai.include": {
            "type": "array",
            "default": [],
            "order": 1,
            "items": {
              "type": "string"
            },
            "description": "Optional glob patterns to include, such as src/**."
          },
          "bonsai.exclude": {
            "type": "array",
            "default": [],
            "order": 2,
            "items": {
              "type": "string"
            },
            "description": "Optional glob patterns to exclude, such as **/generated/**."
          },
          "bonsai.respectGitignore": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Respect .gitignore, global gitignore, and git exclude files."
          },
          "bonsai.binaryPath": {
            "type": "string",
            "default": "",
            "order": 4,
            "description": "Optional fallback path. Bonsai first checks this path, BONSAI_BIN, PATH, and its downloaded binary."
          }
        }
      }
    ]
  },
  "scripts": {
    "sync-version": "ruby ../../scripts/sync-version.rb",
    "compile": "npm run sync-version && tsc -p ./",
    "test": "npm run compile && node dist/bonsai.smoke.test.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run sync-version && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^5.4.5"
  }
}
